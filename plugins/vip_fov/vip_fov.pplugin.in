{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_FOV_VERSION}",
	"name": "vip_fov",
	"description": "[VIP] FOV: the selectable 'FOV' feature opens a menu of the group's comma-separated FOV values; the choice is stored in the 'FOV_Value' cookie and applied to m_iDesiredFOV on spawn. Ported from the Pisex VIP core module VIP_FOV (vip_fov). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_fov",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
